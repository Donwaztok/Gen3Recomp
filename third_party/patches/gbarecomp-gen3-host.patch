diff --git a/src/armv4t/runtime_arm.cpp b/src/armv4t/runtime_arm.cpp
index c7bb752..b8a1c48 100644
--- a/src/armv4t/runtime_arm.cpp
+++ b/src/armv4t/runtime_arm.cpp
@@ -37,6 +37,28 @@ struct DispatchEntry {
 extern "C" const DispatchEntry kDispatchTable[];
 extern "C" const unsigned kDispatchTableLen;
 
+// Optional override installed by the host via runtime_set_cart_dispatch.
+static const DispatchEntry* g_cart_dispatch_override = nullptr;
+static unsigned g_cart_dispatch_override_len = 0;
+
+extern "C" void runtime_set_cart_dispatch(const void* table, unsigned len) {
+    g_cart_dispatch_override =
+        reinterpret_cast<const DispatchEntry*>(table);
+    g_cart_dispatch_override_len = len;
+}
+
+static inline const DispatchEntry* cart_dispatch_table() {
+    return g_cart_dispatch_override != nullptr
+               ? g_cart_dispatch_override
+               : kDispatchTable;
+}
+
+static inline unsigned cart_dispatch_len() {
+    return g_cart_dispatch_override != nullptr
+               ? g_cart_dispatch_override_len
+               : kDispatchTableLen;
+}
+
 // BIOS dispatch table. Lives in src/runtime/generated_bios/
